generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  nextPlacementAt DateTime?
}

model Canva {
  x        Int
  y        Int
  color    Int
  placedAt DateTime @default(now())

  @@id([x, y])
  @@index([placedAt])
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
