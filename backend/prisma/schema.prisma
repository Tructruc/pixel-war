generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(uuid())
  nextPlacementAt DateTime?
}

model Canva {
  x        Int
  y        Int
  color    Int
  placedAt DateTime @default(now())

  @@id([x, y])
  @@index([placedAt])
}

model Template {
  id        String   @id @default(uuid())
  name      String   @unique
  pixels    String   // JSON stringified array of {x, y, color}
  createdAt DateTime @default(now())
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
